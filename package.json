{
  "name": "billing-erp",
  "version": "1.0.0",
  "description": "Full-featured ERP & Billing Software for Wholesale Business",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "build": "vite build",
    "electron": "concurrently \"npm run server\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:dev": "concurrently \"npm run server\" \"npm run client\" \"wait-on http://localhost:5173 && electron .\"",
    "build:obfuscate": "node scripts/obfuscate.js --in server --out server-built",
    "build:obfuscate:debug": "node scripts/obfuscate.js --in server --out server-built --debug",
    "build:check": "node scripts/check_build_ready.js",
    "dist:debug": "vite build && npm run build:obfuscate:debug && npm run build:check && electron-builder --win nsis -c.extraMetadata.buildKind=debug",
    "dist": "vite build && npm run build:obfuscate && npm run build:check && electron-builder --win nsis",
    "dist:dir": "vite build && npm run build:obfuscate && electron-builder --win --dir"
  },
  "dependencies": {
    "@ant-design/icons": "^5.3.0",
    "@fontsource-variable/source-sans-3": "^5.2.9",
    "antd": "^5.15.0",
    "axios": "^1.6.7",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dayjs": "^1.11.10",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.22.1",
    "helmet": "^8.1.0",
    "jsbarcode": "^3.11.6",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.0",
    "recharts": "^2.12.0",
    "sequelize": "^6.37.8",
    "tweetnacl": "^1.0.3",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "^28.3.3",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.4.2",
    "vite": "^5.1.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.sabina.billing-erp",
    "productName": "Billing ERP",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json",
      "node_modules/**/*",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/.cache",
      "!**/test/**",
      "!**/tests/**",
      "!**/.git/**",
      "!server/**/*",
      "!server-built/**/*",
      "!scripts/**/*",
      "!.claude/**/*",
      "!dummy-imports/**/*",
      {
        "from": "server-built",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/pg-native/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Billing-ERP-Setup-${version}.${ext}",
      "publisherName": "Sabina Software"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Billing ERP",
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "scripts/maintenance/",
        "to": "maintenance"
      }
    ]
  }
}
