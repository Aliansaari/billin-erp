node_modules/
dist/
__pycache__/
*.pyc
.env
server.log
*.log
.claude/

# Build artefacts — produced by `npm run dist`. Never check these in.
dist-electron/
server-built/
build/icon.ico

# Bundled portable PostgreSQL — ~150 MB build asset staged locally
# (vendor/pgsql: bin/lib/share + app-local VC++ runtime). Required at
# build time for the one-click host installer; never commit it.
vendor/

# Mobile build artefact — produced by `npm run build:mobile` /
# `npm run cap:sync`. Capacitor copies this into ios/App/App/public on
# each sync, so the actual shipped assets live there, not here.
dist-mobile/

# Runtime data — firm-specific, must never be committed
server/backups/
server/uploads/
backup_*.json

# Phase 4-6 import worker artifacts
uploads/
Wire_Imports_Prompt.md
.DS_Store
