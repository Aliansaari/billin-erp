# ═══════════════════════════════════════════════════════════════════════
# ZEHEN — environment configuration
#
# Copy this file to ".env" at the project root and edit values for your
# deployment. The server reads it at boot via dotenv. Defaults are
# Indian-retail-friendly (single-machine PC); the LAN block is what you
# tune for an office with 10–20 client computers.
#
# Restart the server after changing any value.
# ═══════════════════════════════════════════════════════════════════════

# ─── Required ──────────────────────────────────────────────────────────

# JWT signing secret. MUST be set. Use a long random string (32+ chars).
# If you lose this, every issued token becomes invalid — users have to
# re-login. Don't commit the real value to git.
JWT_SECRET=change-me-to-a-long-random-string

# Developer-mode password. Unlocks the Developer Settings page (toggles
# for Ledger Integrity, Cleanup, Restore, Accounting Sync, LAN cap, etc.).
# Per-device unlock — no DB user record needed. The default ships in
# source as "dev@billing2025"; override here before handing the build
# to a customer. After unlock the Developer Settings page shows
# whether you're still on the default so it's easy to spot.
DEVELOPER_PASSWORD=change-me-to-a-developer-only-secret

# ─── Database ──────────────────────────────────────────────────────────

DB_HOST=localhost
DB_PORT=5432
DB_NAME=billing_erp
DB_USER=postgres
DB_PASSWORD=postgres

# Pool sizing (LAN deployment — bump if you have more concurrent clients)
#
#   max     — maximum number of pooled DB connections. Default 30 covers
#             20 active LAN users with headroom. Raise to 50 if you have
#             40+ clients; lower to 10 for a single-machine install.
#   min     — kept-warm baseline. 2 keeps cold-load latency low.
#   acquire — ms a request will wait for a connection before failing.
#             10 s = "fail fast" so users get an error toast instead of
#             a frozen UI when the pool is starved.
#   idle    — ms a connection sits idle before being closed.
#   evict   — sweep interval for closing idle connections.
DB_POOL_MAX=30
DB_POOL_MIN=2
DB_POOL_ACQUIRE=10000
DB_POOL_IDLE=10000
DB_POOL_EVICT=1000

# Cap on how long a single SQL statement is allowed to run. Protects
# against a runaway report query pinning a connection forever while
# every other LAN client waits. Long-running ops (backup, import) run
# outside this scope so the cap doesn't affect them.
DB_STATEMENT_TIMEOUT_MS=30000

# ─── Server ────────────────────────────────────────────────────────────

# Port the API + SPA listen on. Default 3001. If you change this, every
# LAN client's Server Setup screen must use the new port.
SERVER_PORT=3001

# Build mode. Use "production" when serving real users so static asset
# cache headers come into play. The SPA will be served from /dist
# regardless, as long as `npm run build` was run.
NODE_ENV=production

# ─── CORS for LAN ──────────────────────────────────────────────────────
#
# By default the server auto-allows any RFC1918 private-IP origin
# (192.168.*, 10.*, 172.16-31.*, 169.254.*) plus localhost. That covers
# every reasonable home / office LAN out of the box.
#
# Use CORS_EXTRA_ORIGINS only if you have a custom hostname (mDNS like
# "shop.local") or you've put the server behind a public domain. Comma-
# separated list, no trailing slashes.
#
# CORS_EXTRA_ORIGINS=http://shop.local:3001,https://billing.example.com

# Legacy single-machine setup: the URL where the dev frontend runs.
# Default http://localhost:5173 covers `npm run dev`.
CLIENT_URL=http://localhost:5173

# ─── Frontend (build-time) ─────────────────────────────────────────────
#
# Hard-codes the API base URL into the bundle. Useful when shipping a
# packaged Electron build to a known LAN host. The Server Setup screen
# normally handles this at runtime, but if you want to skip it set
# VITE_API_URL when building:
#
#   VITE_API_URL=http://192.168.1.50:3001 npm run build
#
# (Otherwise leave unset.)
# VITE_API_URL=

# Vite dev-server proxy target. Only relevant for `npm run dev`.
VITE_API_PORT=3001
